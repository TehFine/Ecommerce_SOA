# E-Commerce SOA - Root env example
# Copy: cp .env.example .env  (không commit .env)
# Docker: docker compose up --build tự đọc environment trong docker-compose.yml, file này chỉ để chạy local npm start

# === Gateway 3000 ===
PORT=3000
JWT_SECRET=soa_jwt_secret_2026
USER_SERVICE_URL=http://localhost:3001
PRODUCT_SERVICE_URL=http://localhost:3002
ORDER_SERVICE_URL=http://localhost:3003
PAYMENT_SERVICE_URL=http://localhost:3005
NOTIF_SERVICE_URL=http://localhost:3006
SOAP_GATEWAY_URL=http://localhost:3004
REDIS_URL=redis://localhost:6379
# Khi chạy docker-compose đổi thành:
# REDIS_URL=redis://redis:6379
# USER_SERVICE_URL=http://user-service:3001 ...

# === User Service 3001 (MySQL+Redis mock) ===
# PORT=3001
# JWT_SECRET=soa_jwt_secret_2026
# JWT_EXPIRES=1h
# REFRESH_EXPIRES=7d
# DATABASE_URL=postgresql://user:pass@localhost:5432/ecommerce  # nếu thay in-memory bằng Supabase/Render PG

# === Product Service 3002 (Elasticsearch mock) ===
# PORT=3002

# === Order Service 3003 (PostgreSQL+RabbitMQ mock) ===
# PORT=3003
# RABBITMQ_URL=amqp://guest:guest@localhost:5672
# USER_SERVICE_URL=http://localhost:3001
# PRODUCT_SERVICE_URL=http://localhost:3002

# === Payment SOAP Gateway 3004 ===
# PORT=3004

# === Payment Service 3005 ===
# PORT=3005
# SOAP_WSDL_URL=http://localhost:3004/wsdl?wsdl

# === Notification Service 3006 ===
# PORT=3006
# RABBITMQ_URL=amqp://guest:guest@localhost:5672

# === Supabase (nếu dùng thay in-memory) ===
# SUPABASE_URL=https://xxx.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=xxx
# DATABASE_URL=postgresql://postgres.xxx:pass@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# === MongoDB Atlas (nếu dùng thay SQL) ===
# MONGODB_URI=mongodb+srv://user:pass@cluster.mongodb.net/ecommerce
